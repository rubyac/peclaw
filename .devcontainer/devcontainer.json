{
  "name": "PEClaw trial workspace",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu-24.04",
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:2": {},
    "ghcr.io/devcontainers/features/python:1": { "version": "3.12" },
    "ghcr.io/devcontainers/features/node:1": { "version": "24" }
  },
  "forwardPorts": [3000],
  "portsAttributes": {
    "3000": {
      "label": "PEClaw",
      "protocol": "https",
      "onAutoForward": "notify"
    }
  },
  "postCreateCommand": "python3 scripts/codespaces_start.py --build-only",
  "postStartCommand": "python3 scripts/codespaces_start.py",
  "remoteUser": "vscode"
}
