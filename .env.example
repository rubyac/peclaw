# Copy to .env, replace every CHANGE_ME value. Development only; never commit .env.
APP_ENV=development
POSTGRES_DB=peclaw
POSTGRES_USER=peclaw
POSTGRES_PASSWORD=CHANGE_ME_DB_PASSWORD
# Use URL-safe passwords, or percent-encode the password in this URL.
DATABASE_URL=postgresql+psycopg://peclaw:CHANGE_ME_DB_PASSWORD@localhost:5432/peclaw
REDIS_URL=redis://localhost:6379/0
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY_ID=peclaw-local
S3_SECRET_ACCESS_KEY=CHANGE_ME_STORAGE_PASSWORD
S3_BUCKET=peclaw-documents
S3_REGION=us-east-1
# Server-side only: no NEXT_PUBLIC_ prefix needed, no browser credentials.
API_INTERNAL_URL=http://localhost:8000

# Auth: exact browser origins as JSON; HTTPS + secure cookies mandatory in production.
AUTH_ALLOWED_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
AUTH_COOKIE_SECURE=false
AUTH_SESSION_SECONDS=28800
AUTH_LOGIN_ATTEMPTS=10
AUTH_PEER_LOGIN_ATTEMPTS=500

# Private file bytes; 1 KiB to 10 MiB. Embeddings use bundled local Chinese word vectors.
KNOWLEDGE_MAX_FILE_BYTES=10485760

# Optional generation provider. Disabled until operator configures HTTPS endpoint and secret.
MODEL_PROVIDER=disabled
MODEL_BASE_URL=https://api.deepseek.com/v1
MODEL_NAME=deepseek-chat
MODEL_API_KEY=
MODEL_TIMEOUT_SECONDS=40
MODEL_MAX_OUTPUT_TOKENS=4000
MODEL_ORG_DAILY_TOKEN_LIMIT=200000
MODEL_ORG_CONCURRENCY=1
# Optional USD per million tokens; unset means unknown cost (never zero by assumption).
# MODEL_INPUT_PRICE_PER_MILLION=
# MODEL_OUTPUT_PRICE_PER_MILLION=

# Report draft downloads are watermarked; formal exports always require current peer approval.
REPORT_ALLOW_DRAFT_EXPORT=true
